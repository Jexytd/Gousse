-- ============================================================
local OrdersWatch = { seen = {}, state = "idle" }

if Orders then
    conn(Orders.ChildAdded, function(child)
        OrdersWatch.seen[child] = true
    end)
    for _, c in ipairs(Orders:GetChildren()) do
        OrdersWatch.seen[c] = true
    end
end

