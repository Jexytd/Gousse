-- The local dev server answers 200 with an empty body when the file is not
-- actually being served, so validate that the payload looks like the library
-- before trusting it (otherwise loadstring("")() returns nil).
local function looksLikeLibrary(src)
    return type(src) == "string"
        and #src > 5000
        and src:find("GousseUI", 1, true) ~= nil
end

if not GousseUI then
    local okLocal, localRes = pcall(function()
        return game:HttpGet("http://localhost:3456/library.luau")
    end)
    if okLocal and looksLikeLibrary(localRes) then
        local okLoad, res = pcall(function() return loadstring(localRes)() end)
        if okLoad and res then GousseUI = res end
    end
end

if not GousseUI then
    local okRemote, remoteRes = pcall(function()
        return game:HttpGet(
            "https://raw.githubusercontent.com/Jexytd/Gousse/main/library.luau"
        )
    end)
    if okRemote and looksLikeLibrary(remoteRes) then
        local okLoad, res = pcall(function() return loadstring(remoteRes)() end)
        if okLoad and res then GousseUI = res end
    end
end
if not GousseUI then error("[Burger Planet] GousseUI failed to load") end
GousseUI:SetTheme("emerald")

