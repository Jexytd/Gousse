local function shutdown()
    if not API.running then return end
    API.running = false
    for k in pairs(API.enabled) do API.enabled[k] = false end
    for _, c in ipairs(API.connections) do
        safe(function() c:Disconnect() end)
    end
    table.clear(API.connections)
    if Window then safe(function() Window:Destroy() end) end
end

