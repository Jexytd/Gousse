-- Lowercase, "&" -> "and", "×" -> "x", drop punctuation, pad with spaces.
local function normalise(text)
    local t = tostring(text or ""):lower()
    t = t:gsub("&", " and ")
    t = t:gsub("×", " x ")
    t = t:gsub("[^%w%s%-]", " ")
    t = t:gsub("%-", " ")
    t = t:gsub("%s+", " ")
    return " " .. t .. " "
end

-- Build a frontier-anchored pattern so "Cheeseburger" never eats "Bacon Cheeseburger".
local function namePattern(raw)
    local n = normalise(raw)
    n = n:gsub("^%s+", ""):gsub("%s+$", "")
    n = n:gsub("%s+", "%%s+")
    return n
end

local function wordCount(raw)
    local n = normalise(raw)
    local count = 0
    for _ in string.gmatch(n, "%S+") do count += 1 end
    return math.max(1, count)
end

local function buildMenuTable(menuList)
    local out, seen = {}, {}

    local function add(id, name)
        if id == nil or id == "" or seen[id] then return end
        seen[id] = true
        local display = name
        if (not display or display == "") and MenuConfig and MenuConfig.Menu then
            local meta = MenuConfig.Menu[id]
            display = meta and meta.Name or nil
        end
        if not display or display == "" then
            display = MENU_FALLBACK[id] or tostring(id)
        end
        out[#out + 1] = {
            id = tostring(id),
            name = display,
            pat = namePattern(display),
            words = wordCount(display),
        }
    end

    if type(menuList) == "table" then
        for _, entry in ipairs(menuList) do
            if type(entry) == "table" then
                add(entry.Id or entry.id, entry.Name or entry.name)
            elseif type(entry) == "string" then
                add(entry)
            end
        end
    end

    -- Merge the baked menu so breakfast/truck menus resolve even if the payload
    -- only carried a partial list.
    if MenuConfig and MenuConfig.MenuOrder then
        for _, id in ipairs(MenuConfig.MenuOrder) do add(id) end
    else
        for id, name in pairs(MENU_FALLBACK) do add(id, name) end
    end

    table.sort(out, function(a, b) return #a.pat > #b.pat end)
    return out
end

local function recipeOf(id)
    if Builds and Builds.recipe then
        local ok, res = pcall(Builds.recipe, id)
        if ok and type(res) == "table" then return res end
    end
    if MenuConfig and MenuConfig.Recipes and MenuConfig.Recipes[id] then
        local counts = {}
        for _, f in ipairs(MenuConfig.Recipes[id]) do
            counts[f] = (counts[f] or 0) + 1
        end
        return counts
    end
    local baked = RECIPES_FALLBACK[id]
    return baked and table.clone(baked) or {}
end

local FILLING_CACHE
local function fillingMatchers()
    if FILLING_CACHE then return FILLING_CACHE end
    local info = (Builds and Builds.INFO) or {}
    local out = {}
    for _, key in ipairs(FILLINGS) do
        local meta = info[key] or FILLING_META_FALLBACK[key] or { Name = key, Plural = key:lower() }
        local max = tonumber(meta.Max) or 3
        local candidates = { meta.Name, meta.Plural }
        if meta.Name ~= key then table.insert(candidates, key) end
        local seen = {}
        for _, nm in ipairs(candidates) do
            if type(nm) == "string" and nm ~= "" then
                local pat = namePattern(nm)
                if not seen[pat] then
                    seen[pat] = true
                    out[#out + 1] = { key = key, pat = pat, max = max, words = wordCount(nm) }
                end
            end
        end
    end
    local synonyms = {
        { key = "Mayo",    word = "mayonnaise",      max = 2 },
        { key = "BBQ",     word = "bbq sauce",       max = 2 },
        { key = "BBQ",     word = "barbecue",        max = 2 },
        { key = "BBQ",     word = "barbeque",        max = 2 },
        { key = "Ketchup", word = "catsup",          max = 2 },
        { key = "Patty",   word = "hamburger patty", max = 3 },
    }
    for _, s in ipairs(synonyms) do
        out[#out + 1] = { key = s.key, pat = namePattern(s.word), max = s.max, words = wordCount(s.word) }
    end
    table.sort(out, function(a, b) return #a.pat > #b.pat end)
    FILLING_CACHE = out
    return out
end

