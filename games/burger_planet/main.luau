-- ============================================================
-- HELPERS
-- ============================================================
local function root()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function primaryPart(node)
    if not node then return nil end
    if node:IsA("BasePart") then return node end
    if node:IsA("Model") then
        return node.PrimaryPart
            or node:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    return ok, err
end

local function teleportTo(pos)
    local r = root()
    if not r or not pos then return end
    safe(function()
        r.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
    end)
    task.wait(0.15)
end

local function allInteractNodes()
    local hits = {}
    local function walk(node, depth)
        if depth > 5 or not node then return end
        for _, child in ipairs(node:GetChildren()) do
            if child:GetAttribute("Interact") ~= nil then
                table.insert(hits, child)
            end
            if child:IsA("Folder") or child:IsA("Model") then
                walk(child, depth + 1)
            end
        end
    end
    walk(WStations(), 0)
    walk(SiteMod.root, 1)
    return hits
end

local function discoverRemotes(predicate)
    local hits = {}
    local function walk(node, depth)
        if depth > 4 or not node then return end
        for _, child in ipairs(node:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                if predicate(child) then table.insert(hits, child) end
            elseif child:IsA("Folder") then
                walk(child, depth + 1)
            end
        end
    end
    walk(Remotes, 0)
    return hits
end

local API = { enabled = {}, connections = {}, flags = {}, running = true }

local function conn(sig, fn)
    local c = sig:Connect(fn)
    table.insert(API.connections, c)
    return c
end

local function snapshot()
    local s = {}
    for _, attr in ipairs({
        "Money","Level","XP","XPNext","Day","Clock","Phase","Shift",
        "Stars","Rating","RatingCount","GameMode","Site","RestaurantName",
        "DriveOpen","FrontOpen","DriveLevel","DeliveryOpen","Pending",
        "HotStreak","HotMult","HotEnds",
    }) do
        s[attr] = State:GetAttribute(attr)
    end
    return s
end

-- ============================================================
-- MODULE: SITE (Restaurant vs Food Truck)
-- ============================================================
local function resolveSite()
    local tag = tostring(State:GetAttribute("Site") or "Restaurant")
    local truck = (tag == "Truck")
    local want = truck and "FoodTruck" or "FastFood"
    local alt  = truck and "FastFood" or "FoodTruck"
    local node = Workspace:FindFirstChild(want) or Workspace:FindFirstChild(alt)
    if node and node ~= SiteMod.root then
        SiteMod.generation += 1
    end
    SiteMod.name, SiteMod.truck, SiteMod.root = tag, truck, node
    return node
end

resolveSite()
conn(State:GetAttributeChangedSignal("Site"), function()
    local before = SiteMod.root
    resolveSite()
    if SiteMod.root ~= before then
        print(("[Burger Planet] site switched -> %s (%s)"):format(
            SiteMod.name,
            SiteMod.root and SiteMod.root:GetFullName() or "nil"))
        GousseUI:Notify({
            Title = "Site",
            Content = "Now on " .. SiteMod.name,
            Type = "info", Duration = 4,
        })
    end
end)

