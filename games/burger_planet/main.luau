}

local function qtyBefore(t, fromPos, toPos)
    local win = string.sub(t, math.max(1, fromPos), math.max(1, toPos - 1))
    local n = string.match(win, "(%d+)%s*x%s*$")
        or string.match(win, "x%s*(%d+)%s*$")
        or string.match(win, "(%d+)%s*$")
    if n then return math.clamp(tonumber(n) or 1, 1, 20) end
    local word = string.match(win, "([%a]+)%s*$")
    if word and NUMBER_WORDS[word] then
        return math.clamp(NUMBER_WORDS[word], 1, 20)
    end
    return 1
end

-- "with no pickles and extra cheese x 2" -> { Pickles = 0, Cheese = base + 2 }
local function applyChanges(window, recipe)
    local words = {}
    for w in string.gmatch(normalise(window), "%S+") do words[#words + 1] = w end
    if #words == 0 then return nil end

    local matchers = fillingMatchers()
    local ops = {}

    local function matchFilling(tail)
        for _, m in ipairs(matchers) do
            if tail:find("^" .. m.pat .. "%f[%W]") then
                return m
            end
        end
        return nil
    end

    local i = 1
    while i <= #words do
        local w = words[i]
        local mode, skip = nil, 0
        if w == "no" or w == "without" then
            mode = "zero"
        elseif w == "extra" or w == "add" then
            mode = "add"
        elseif w == "only" then
            mode = "only"
        elseif w == "one" and words[i + 1] == "less" then
            mode, skip = "minus", 1
        end

        if mode then
            local j = i + 1 + skip
            local forced = nil
            if mode == "only" then
                forced = tonumber(words[j] or "")
                if forced then j += 1 end
            end
            if j <= #words then
                local tail = table.concat(words, " ", j) .. " "
                local m = matchFilling(tail)
                if m then
                    local amount = forced or 1
                    local k = j + m.words
                    if words[k] == "x" then
                        amount = tonumber(words[k + 1] or "") or amount
                        k += 2
                    end
                    ops[#ops + 1] = { key = m.key, mode = mode, amount = amount, max = m.max }
                    i = k
                else
                    i += 1
                end
            else
                i += 1
            end
        else
            i += 1
        end
    end

    if #ops == 0 then return nil end

    local build = {}
    for _, f in ipairs(FILLINGS) do build[f] = recipe[f] or 0 end
    for _, op in ipairs(ops) do
        local base = build[op.key] or 0
        if op.mode == "zero" then
            base = 0
        elseif op.mode == "add" then
            base = base + op.amount
        elseif op.mode == "minus" then
            base = base - op.amount
        elseif op.mode == "only" then
            base = op.amount
        end
        build[op.key] = math.clamp(base, 0, op.max)
    end
    return build
end

local function scanItems(text, menu)
    local t = normalise(text)
    local matches = {}
    local pos = 1
    while pos <= #t do
        local best
        for _, entry in ipairs(menu) do
            local s, e = string.find(t, "%f[%w]" .. entry.pat .. "s?%f[%W]", pos)
            if s and (not best or s < best.s or (s == best.s and e > best.e)) then
                best = { s = s, e = e, entry = entry }
            end
        end
        if not best then break end
        matches[#matches + 1] = best
        pos = best.e + 1
    end
    return t, matches
end

local function parseRequest(text, menuList)
    local menu = buildMenuTable(menuList)
    local t, matches = scanItems(text, menu)
    local items, builds, plan = {}, {}, {}

    for i, m in ipairs(matches) do
        local prevEnd = (i > 1) and (matches[i - 1].e + 1) or 1
        local qty = qtyBefore(t, prevEnd, m.s)
        local nextStart = matches[i + 1] and matches[i + 1].s or (#t + 1)
        local window = string.sub(t, m.e + 1, nextStart - 1)

        local recipe = recipeOf(m.entry.id)
        local build = nil
        if next(recipe) ~= nil then
            build = applyChanges(window, recipe)
        end

        for _ = 1, qty do
            items[#items + 1] = m.entry.id
            builds[#builds + 1] = build and table.clone(build) or false
        end
        plan[#plan + 1] = {
            id = m.entry.id, qty = qty, build = build,
            text = string.sub(t, m.s, m.e),
        }
    end

    return {
        items = items,
        builds = builds,
        plan = plan,
        menu = menu,
        text = t,
    }
end

-- ============================================================
-- MODULE: REGISTER (click + submit + handoff)
-- ============================================================
local RegisterMod = {
    interval = 0.6, teleport = true, handoff = true,
    autoKind = "auto",
    submitted = {}, clicked = {}, done = {},
    cooldown = 10, retry = 2.5, dedupeWindow = 120,
    gen = -1,
    requests = {}, history = {}, results = {},
    resultToast = true,
    forceOnce = false,
    lastOpen = nil, lastSubmit = nil, lastResult = nil, lastKey = nil,
    failReason = nil,
}

local function decodeJSON(str)
    if type(str) ~= "string" or str == "" then return nil end
    local ok, res = pcall(HttpService.JSONDecode, HttpService, str)
    if ok and type(res) == "table" then return res end
    return nil
end

local function findOrderFor(customer)
    if not Orders or not customer or customer == "" then return nil end
    for _, o in ipairs(Orders:GetChildren()) do
        local c = tostring(o:GetAttribute("Customer") or "")
        if c == customer then return o end
    end
    return nil
end

local function kindFor(payload, order)
    if order then
        local k = order:GetAttribute("Kind")
        if type(k) == "string" and k ~= "" then return k end
    end
    if payload.Drive then return "Drive" end
    local kinds = payload.Kinds
    if type(kinds) == "table" and #kinds == 1 and kinds[1] == "TakeOut" then
        return "TakeOut"
    end
    if RegisterMod.autoKind ~= "auto" then return RegisterMod.autoKind end
    return "DineIn"
end

local function normaliseOrderArrays(items, builds)
    local out = {}
    for i = 1, #items do
        local b = builds[i]
        if type(b) == "table" and next(b) == nil then b = nil end
        out[i] = b or false
    end
    for i = #items + 1, #builds do out[i] = false end
    return out
end

local function recordRequest(payload)
    local row = {
        customer = tostring(payload.Customer or ""),
        request = tostring(payload.Request or ""),
        register = tostring(payload.Register or ""),
        drive = payload.Drive == true,
        menu = payload.Menu,
        kinds = payload.Kinds,
        at = os.clock(),
    }
    RegisterMod.lastOpen = row
    table.insert(RegisterMod.requests, 1, row)
    while #RegisterMod.requests > 12 do table.remove(RegisterMod.requests) end
    return row
end

local function submitOrder(payload, items, builds, kind, source)
    builds = normaliseOrderArrays(items, builds or {})

    RegisterMod.lastSubmit = {
        customer = tostring(payload.Customer or ""),
        items = table.clone(items),
        builds = table.clone(builds),
        kind = kind,
        source = source,
        request = tostring(payload.Request or ""),
        at = os.clock(),
    }
    table.insert(RegisterMod.history, 1, RegisterMod.lastSubmit)
    while #RegisterMod.history > 12 do table.remove(RegisterMod.history) end

    local ok, err = pcall(function()
        R.POS:FireServer("Submit", {
            Items = items,
            Kind = kind,
            Builds = builds,
        })
    end)
    if not ok then
        RegisterMod.failReason = "FireServer failed: " .. tostring(err)
        return false, err
    end

    local cust = RegisterMod.lastSubmit.customer
    if cust ~= "" then RegisterMod.submitted[cust] = os.clock() end
    return true
end

-- Turn one POS "Open" payload into a Submit.
--  1. The customer's spoken Request text is authoritative (it is generated by
--     the server from the very Items/Builds it expects back).
--  2. If the text cannot be parsed, fall back to an already existing order
--     child for that customer.
--  3. Never place a second order for a customer that already has one, and
--     never re-submit the same customer+request inside the dedupe window.
local function submitKey(customer, request)
    return tostring(customer) .. "\0" .. tostring(request)
end

local function submitFromPayload(payload, force)
    if type(payload) ~= "table" then return false, "payload was not a table" end

    local customer = tostring(payload.Customer or "")
    local request = tostring(payload.Request or "")
    local key = submitKey(customer, request)
    local now = os.clock()

    local existing = findOrderFor(customer)
    if existing and not force then
        local st = existing:GetAttribute("Status")
        if st == "Open" or st == "Ready" then
            RegisterMod.failReason = "order already placed (" .. existing.Name .. ")"
            return false, RegisterMod.failReason
        end
    end

    local lastDone = RegisterMod.done[key]
    if lastDone and (now - lastDone) < RegisterMod.dedupeWindow and not force then
        RegisterMod.failReason = "already submitted this request"
        return false, RegisterMod.failReason
    end

    local items, builds, source
    local parsed = parseRequest(request, payload.Menu)
    if #parsed.items > 0 then
        items, builds, source = parsed.items, parsed.builds, "request"
    elseif existing then
        local oi = decodeJSON(existing:GetAttribute("Items"))
        if type(oi) == "table" and #oi > 0 then
            items = oi
            builds = decodeJSON(existing:GetAttribute("Builds")) or {}
            source = "order:" .. existing.Name
        end
    end

    if not items or #items == 0 then
        RegisterMod.failReason = "nothing parsed from request: "
            .. tostring(payload.Request or "<empty>")
        return false, RegisterMod.failReason
    end

    RegisterMod.lastKey = key
    RegisterMod.failReason = nil
    local ok, err = submitOrder(payload, items, builds, kindFor(payload, existing), source)
    if ok then RegisterMod.done[key] = now end
    return ok, err
end

if R.POS then
    conn(R.POS.OnClientEvent, function(cmd, payload)
        if cmd == "Open" then
            if type(payload) ~= "table" then return end
            recordRequest(payload)
            if API.enabled.register or RegisterMod.forceOnce then
                RegisterMod.forceOnce = false
                task.defer(function() submitFromPayload(payload) end)
            end
            return
        end

        if cmd == "Result" then
            local okFlag = type(payload) == "table" and payload.Ok == true
            local msg = type(payload) == "table"
                and tostring(payload.Message or "") or "no message"
            RegisterMod.lastResult = { ok = okFlag, msg = msg, at = os.clock() }
            table.insert(RegisterMod.results, 1, RegisterMod.lastResult)
            while #RegisterMod.results > 12 do table.remove(RegisterMod.results) end

            if not okFlag then
                -- let the same customer be retried on the next pass
                local cust = RegisterMod.lastSubmit and RegisterMod.lastSubmit.customer
                if cust and cust ~= "" then RegisterMod.submitted[cust] = nil end
                if RegisterMod.lastKey then RegisterMod.done[RegisterMod.lastKey] = nil end
                RegisterMod.failReason = "server: " .. msg
            else
                RegisterMod.failReason = nil
            end

            print(("[Burger Planet] POS Result: %s — %s")
                :format(okFlag and "OK" or "FAIL", msg))

            if RegisterMod.resultToast then
                GousseUI:Notify({
                    Title = "Register " .. (okFlag and "accepted" or "rejected"),
                    Content = msg,
                    Type = okFlag and "success" or "warning",
                    Duration = okFlag and 3 or 6,
                })
            end
        end
    end)
end

local function isRegisterNode(node)
    if not node:IsA("BasePart") then return false end
    local tag = tostring(node:GetAttribute("Interact") or ""):lower()
    if tag == "register" or tag:find("register", 1, true) then return true end
    if tag:find("cashier", 1, true) then return true end
    if tag == "pos" or tag:find("pos", 1, true) then return true end
    return node.Name:lower():find("register", 1, true) ~= nil
end

local function findWaitingRegisters()
    local out, seen = {}, {}
    local now = os.clock()
    for _, child in ipairs(allInteractNodes()) do
        if isRegisterNode(child) then
            local parent = child.Parent
            if parent
                and parent:GetAttribute("Customer") ~= nil
                and parent:GetAttribute("Enabled") ~= false then
                local cust = tostring(parent:GetAttribute("Customer") or "")
                local key = cust ~= "" and cust or parent:GetFullName()
                local last = RegisterMod.submitted[key]
                if not (last and now - last < RegisterMod.cooldown) and not seen[parent] then
                    seen[parent] = true
                    table.insert(out, {
                        part = child, model = parent, customer = cust, key = key,
                    })
                end
            end
        end
    end
    return out
end

local function clickRegister(reg)
    if RegisterMod.teleport then teleportTo(reg.part.Position) end
    safe(function()
        R.Interact:FireServer(reg.part, "Primary", reg.part.Position)
    end)
end

local function findReadyOrders()
    local out = {}
    if not Orders then return out end
    for _, o in ipairs(Orders:GetChildren()) do
        if o:GetAttribute("Status") == "Ready" then
            table.insert(out, {
                order = o,
                customer = o:GetAttribute("Customer"),
                kind = o:GetAttribute("Kind") or "DineIn",
                orderId = o:GetAttribute("Id"),
            })
        end
    end
    return out
end

local function handoffReady(ready)
    local npcs = WNPCs()
    if not (npcs and ready.customer) then return false end
    local tag = ready.kind == "Delivery" and "DeliveryCustomer" or "Customer"
    for _, npc in ipairs(npcs:GetChildren()) do
        if npc:IsA("Model") and npc:GetAttribute("Interact") == tag then
            local match
            if ready.kind == "Delivery" then
                match = npc:GetAttribute("OrderId") == ready.orderId
            else
                match = npc:GetAttribute("CustomerName") == ready.customer
            end
            if match then
                local p = primaryPart(npc)
                if p then
                    local r = root()
                    if r and (p.Position - r.Position).Magnitude > 6 then
                        teleportTo(p.Position)
                    end
                    safe(function()
                        R.Interact:FireServer(npc, "Primary", p.Position)
                    end)
                    return true
                end
            end
        end
    end
    return false
end

function RegisterMod.sweep()
    if SiteMod.generation ~= RegisterMod.gen then
        RegisterMod.gen = SiteMod.generation
        table.clear(RegisterMod.submitted)
        table.clear(RegisterMod.clicked)
        table.clear(RegisterMod.done)
    end

    local now = os.clock()
    local clicked = 0
    for _, reg in ipairs(findWaitingRegisters()) do
        local last = RegisterMod.clicked[reg.key]
        if not last or now - last > RegisterMod.retry then
            RegisterMod.clicked[reg.key] = now
            clickRegister(reg)
            clicked += 1
            task.wait(0.12)
        end
    end

    if RegisterMod.handoff and LP:GetAttribute("Holding") ~= nil then
        for _, ready in ipairs(findReadyOrders()) do
            handoffReady(ready)
            task.wait(0.15)
        end
    end

    return clicked
end

function RegisterMod.submitLast()
    if not RegisterMod.lastOpen then return false, "no POS payload seen yet" end
    return submitFromPayload({
        Customer = RegisterMod.lastOpen.customer,
        Request = RegisterMod.lastOpen.request,
        Register = RegisterMod.lastOpen.register,
        Drive = RegisterMod.lastOpen.drive,
        Kind = RegisterMod.lastOpen.kind,
        Kinds = RegisterMod.lastOpen.kinds,
        Menu = RegisterMod.lastOpen.menu,
    }, true)
end

function RegisterMod.status()
    local n = 0
    for _ in pairs(RegisterMod.submitted) do n += 1 end
    local lastResult = "-"
    if RegisterMod.lastResult then
        lastResult = (RegisterMod.lastResult.ok and "OK " or "FAIL ")
            .. RegisterMod.lastResult.msg
    end
    return {
        enabled = API.enabled.register,
        site = SiteMod.name,
        pending = #findWaitingRegisters(),
        ready = #findReadyOrders(),
        submitted = n,
        source = RegisterMod.lastSubmit and RegisterMod.lastSubmit.source or "-",
        result = lastResult,
        fail = RegisterMod.failReason or "-",
    }
end

function RegisterMod.dumpOrders()
    local rows = {}
    if not Orders then return rows end
    for _, o in ipairs(Orders:GetChildren()) do
        table.insert(rows, ("%s [%s] %s :: %s"):format(
            o.Name,
            tostring(o:GetAttribute("Status")),
            tostring(o:GetAttribute("Customer")),
            tostring(o:GetAttribute("Items"))))
    end
    return rows
end


-- ============================================================
-- MODULE: COOK (grill slots, fryer baskets, warmer bays)
-- ============================================================
local CookMod = {
    interval = 0.4, teleport = true,
    grill = true, fryer = true, warmer = true,
    stats = { grill = 0, fryer = 0, warmer = 0 },
}

local function findFirstStation(namePattern)
    local stations = WStations()
    if not stations then return nil end
    for _, child in ipairs(stations:GetChildren()) do
        if child:IsA("Model") and child.Name:lower():find(namePattern) then
            return child
        end
    end
    return nil
end

local function collectNamedParts(model, pattern)
    local out = {}
    if not model then return out end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Name:lower():find(pattern) then
            table.insert(out, desc)
        end
    end
    return out
end

local function fireInteract(part, action, pos)
    if not part then return false end
    if CookMod.teleport and pos then teleportTo(pos) end
    safe(function()
        R.Interact:FireServer(part, action or "Primary",
            pos or part.Position)
    end)
    return true
end

function CookMod.grillTick()
    if not CookMod.grill then return 0 end
    local grill = findFirstStation("^grill")
    if not grill then return 0 end

    -- Restaurant grills expose Slot1..Slot6 with Interact=GrillSlot.
    local slots = {}
    for _, c in ipairs(grill:GetChildren()) do
        if c:IsA("BasePart") and c.Name:lower():find("slot") then
            table.insert(slots, c)
        end
    end

    -- Food truck grill: one PlateHit (Interact=GrillPlate) serves every SlotN;
    -- the slot parts themselves carry only state attributes.
    if #slots == 0 then
        local plate
        for _, d in ipairs(grill:GetDescendants()) do
            if d:IsA("BasePart") and d:GetAttribute("Interact") == "GrillPlate" then
                plate = d
                break
            end
        end
        if not plate then return 0 end
        local busy, done = 0, false
        for _, c in ipairs(grill:GetChildren()) do
            if c:IsA("BasePart") and c.Name:lower():find("slot") then
                if c:GetAttribute("Done") or c:GetAttribute("Ready") then done = true end
                if c:GetAttribute("Item") or c:GetAttribute("Kind")
                    or c:GetAttribute("Cooking") then busy += 1 end
            end
        end
        if done or busy > 0 then
            fireInteract(plate, "Primary", plate.Position)
            CookMod.stats.grill = 1
            return 1
        end
        return 0
    end

    local n = 0
    for _, slot in ipairs(slots) do
        local holding = slot:GetAttribute("Item") or slot:GetAttribute("Kind")
        local cooking = slot:GetAttribute("Cooking")
        local done = slot:GetAttribute("Done") or slot:GetAttribute("Ready")
        if done then
            fireInteract(slot, "Primary", slot.Position); n += 1
        elseif not cooking and not holding then
            fireInteract(slot, "Primary", slot.Position); n += 1
        end
        task.wait(0.05)
    end
    CookMod.stats.grill = n
    return n
end

function CookMod.fryerTick()
    if not CookMod.fryer then return 0 end
    local fryers = { findFirstStation("^fryer") }
    local n = 0
    for _, fryer in ipairs(fryers) do
        if fryer then
            local hits = collectNamedParts(fryer, "baskethit")
            if #hits == 0 then
                hits = collectNamedParts(fryer, "basket")
            end
            for _, hit in ipairs(hits) do
                local holding = hit:GetAttribute("Item") or hit:GetAttribute("Kind")
                local done = hit:GetAttribute("Done") or hit:GetAttribute("Ready")
                local cooking = hit:GetAttribute("Cooking")
                if done or (not cooking and not holding) then
                    fireInteract(hit, "Primary", hit.Position); n += 1
                end
                task.wait(0.05)
            end
        end
    end
    CookMod.stats.fryer = n
    return n
end

function CookMod.warmerTick()
    if not CookMod.warmer then return 0 end
    local warmer = findFirstStation("^warmer")
    if not warmer then return 0 end
    local keys = { "frieshit", "hashbrownshit", "nuggetshit", "onionringshit" }
    local n = 0
    for _, k in ipairs(keys) do
        local parts = collectNamedParts(warmer, k)
        for _, part in ipairs(parts) do
            local holding = part:GetAttribute("Item") or part:GetAttribute("Kind")
            local empty = not holding
            if empty then
                fireInteract(part, "Primary", part.Position); n += 1
            end
            task.wait(0.05)
        end
    end
    CookMod.stats.warmer = n
    return n
end

function CookMod.sweep()
    local total = 0
    total += CookMod.grillTick()
    total += CookMod.fryerTick()
    total += CookMod.warmerTick()
    return total
end

-- ============================================================
-- MODULE: ASSEMBLY (build order at island A/B)
-- ============================================================
local AssemblyMod = { interval = 0.5, teleport = true }

local function findAssemblyZones()
    local out = {}
    local stations = WStations()
    if not stations then return out end
    for _, child in ipairs(stations:GetChildren()) do
        if child:IsA("Model") and child.Name:lower():find("assembly") then
            for _, part in ipairs(child:GetChildren()) do
                if part:IsA("BasePart") and part:GetAttribute("Interact") then
                    table.insert(out, part)
                end
            end
        end
    end
    return out
end

function AssemblyMod.sweep()
    if not R.Interact then return 0 end
    local n = 0
    for _, zone in ipairs(findAssemblyZones()) do
        if AssemblyMod.teleport then teleportTo(zone.Position) end
        safe(function()
            R.Interact:FireServer(zone, "Primary", zone.Position)
        end)
        n += 1
        task.wait(0.1)
    end
    return n
end

-- ============================================================
-- MODULE: DRIVETHRU (register 3 + window hit)
-- ============================================================
local DriveMod = { interval = 0.5, teleport = true }

local function findDriveStation()
    -- the food truck has no drive-thru lane (Config.Truck.NoUpgrades.SecondRegister)
    if SiteMod.truck then return nil end
    local stations = WStations()
    if not stations then return nil end
    for _, c in ipairs(stations:GetChildren()) do
        if c:IsA("Model") and c.Name:lower():find("drivethru") then
            return c
        end
    end
    return nil
end

local function findDriveRegister(station)
    if not station then return nil end
    for _, c in ipairs(station:GetChildren()) do
        if c:IsA("Model") and c.Name:lower():find("register") then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart")
                    and part:GetAttribute("Interact") == "Register" then
                    return part
                end
            end
        end
    end
    return nil
end

local function findDriveWindow(station)
    if not station then return nil end
    for _, c in ipairs(station:GetChildren()) do
        if c:IsA("BasePart") and c.Name:lower():find("window") then
            return c
        end
    end
    return nil
end

function DriveMod.sweep()
    local station = findDriveStation()
    if not station then return 0 end
    local n = 0
    local reg = findDriveRegister(station)
    if reg then
        if DriveMod.teleport then teleportTo(reg.Position) end
        safe(function()
            R.Interact:FireServer(reg, "Primary", reg.Position)
        end)
        n += 1
    end
    local win = findDriveWindow(station)
    if win and LP:GetAttribute("Holding") ~= nil then
        if DriveMod.teleport then teleportTo(win.Position) end
        safe(function()
            R.Interact:FireServer(win, "Primary", win.Position)
        end)
        n += 1
    end
    return n
end

-- ============================================================
-- MODULE: FARM (open + order probe remotes)
-- ============================================================
local FarmMod = { interval = 0.5, orderRemotes = nil }

local function getOrderRemotes()
    if FarmMod.orderRemotes then return FarmMod.orderRemotes end
    FarmMod.orderRemotes = discoverRemotes(function(r)
        local n = r.Name:lower()
        return n:find("order") or n:find("serve") or n:find("submit")
    end)
    return FarmMod.orderRemotes
end

function FarmMod.fireOrders()
    local fired = 0
    for _, remote in ipairs(getOrderRemotes()) do
        safe(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer()
                fired += 1
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer("Submit", {
                    Items = {}, Kind = "TakeOut", Builds = {},
                })
                fired += 1
            end
        end)
    end
    return fired
end

