-- MODULE: SITE (Restaurant vs Food Truck)
-- ============================================================
local function resolveSite()
    local tag = tostring(State:GetAttribute("Site") or "Restaurant")
    local truck = (tag == "Truck")
    local want = truck and "FoodTruck" or "FastFood"
    local alt  = truck and "FastFood" or "FoodTruck"
    local node = Workspace:FindFirstChild(want) or Workspace:FindFirstChild(alt)
    if node and node ~= SiteMod.root then
        SiteMod.generation += 1
    end
    SiteMod.name, SiteMod.truck, SiteMod.root = tag, truck, node
    return node
end

resolveSite()
conn(State:GetAttributeChangedSignal("Site"), function()
    local before = SiteMod.root
    resolveSite()
    if SiteMod.root ~= before then
        print(("[Burger Planet] site switched -> %s (%s)"):format(
            SiteMod.name,
            SiteMod.root and SiteMod.root:GetFullName() or "nil"))
        GousseUI:Notify({
            Title = "Site",
            Content = "Now on " .. SiteMod.name,
            Type = "info", Duration = 4,
        })
    end
end)

