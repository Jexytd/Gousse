RegTab:CreateButton({
    Name = "Show Request Log",
    SubTitle = "Last POS 'Customer says' texts as the server wrote them",
    ButtonText = "Log",
    Variant = "secondary",
    Callback = function()
        if #RegisterMod.requests == 0 then
            GousseUI:Notify({ Title = "Request log",
                Content = "No POS Open payload seen yet — click a register first",
                Type = "info", Duration = 4 })
            return
        end
        local lines = {}
        for i, row in ipairs(RegisterMod.requests) do
            if i > 6 then break end
            lines[#lines + 1] = ("%s [%s] %s"):format(
                row.customer ~= "" and row.customer or "?",
                row.drive and "Drive" or "Counter",
                row.request)
        end
        GousseUI:Notify({ Title = "Request log",
            Content = table.concat(lines, "\n"),
            Type = "info", Duration = 12 })
    end,
})
RegTab:CreateButton({
    Name = "Show Last Submit",
    SubTitle = "Items / Builds / Kind that were actually fired",
    ButtonText = "Show",
    Variant = "secondary",
    Callback = function()
        local sub = RegisterMod.lastSubmit
        if not sub then
            GousseUI:Notify({ Title = "Last submit",
                Content = "Nothing submitted yet",
                Type = "info", Duration = 3 })
            return
        end
        local lines = {
            "customer: " .. (sub.customer ~= "" and sub.customer or "?"),
            "kind    : " .. sub.kind,
            "source  : " .. sub.source,
            "items   : " .. table.concat(sub.items, ", "),
        }
        for i, b in ipairs(sub.builds) do
            if i > 6 then break end
            if b then
                local parts = {}
                for k, v in pairs(b) do
                    if v > 0 then parts[#parts + 1] = k .. "=" .. v end
                end
                lines[#lines + 1] = ("build %d : %s"):format(i, table.concat(parts, " "))
            end
        end
        GousseUI:Notify({ Title = "Last submit",
            Content = table.concat(lines, "\n"),
            Type = "info", Duration = 10 })
    end,
})


