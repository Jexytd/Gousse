-- Burger Planet: Fast Food Simulator — v7.0 (site-aware, order-driven register)
-- Executor: Potassium / Synapse / Krnl / Delta / Fluxus / any modern executor
-- Built against the shipped FastFoodClient source + instance dump.
-- Modules: Site (Restaurant / Food Truck), Session, Litter, Register, Handoff,
--          Farm, Cook (grill/fryer/warmer), Assembly (build + serve),
--          DriveThru, Orders watcher, Tools, State.
--
-- Register contract this build targets:
--   * POS:FireServer("Submit", { Items = {id,...}, Builds = {map|false,...}, Kind = ... })
--     Items repeat once per quantity; Builds is a parallel array.
--   * Order text arrives in the POS "Open" payload as `Request`, generated by the
--     server with Builds.describeOrder(items, builds) -> "a Cheeseburger with no
--     pickles and 2 Colas". That text is parsed back into Items/Builds here.
--   * If an "Open" order for that customer already exists in FastFood.Orders its
--     Items/Builds attributes are used verbatim instead of the text parse.
--   * FastFood.State:GetAttribute("Site") == "Truck" -> Workspace.FoodTruck,
--     anything else -> Workspace.FastFood (same rule as FastFoodClient Main.luau).

-- ============================================================
-- GousseUI RESOLUTION
-- ============================================================
local passedUI = ...
local env = (getgenv and getgenv()) or _G or {}
local GousseUI = passedUI or env.GousseUI

-- The local dev server answers 200 with an empty body when the file is not
-- actually being served, so validate that the payload looks like the library
-- before trusting it (otherwise loadstring("")() returns nil).
local function looksLikeLibrary(src)
    return type(src) == "string"
        and #src > 5000
        and src:find("GousseUI", 1, true) ~= nil
end

if not GousseUI then
    local okLocal, localRes = pcall(function()
        return game:HttpGet("http://localhost:3456/library.luau")
    end)
    if okLocal and looksLikeLibrary(localRes) then
        local okLoad, res = pcall(function() return loadstring(localRes)() end)
        if okLoad and res then GousseUI = res end
    end
end

if not GousseUI then
    local okRemote, remoteRes = pcall(function()
        return game:HttpGet(
            "https://raw.githubusercontent.com/Jexytd/Gousse/main/library.luau"
        )
    end)
    if okRemote and looksLikeLibrary(remoteRes) then
        local okLoad, res = pcall(function() return loadstring(remoteRes)() end)
        if okLoad and res then GousseUI = res end
    end
end
if not GousseUI then error("[Burger Planet] GousseUI failed to load") end
GousseUI:SetTheme("default")

-- Re-execution guard: shut the previous instance down first, otherwise every
-- run leaves another set of workers + POS listeners behind (duplicate submits).
local previousBP = env.BP
if type(previousBP) == "table" and type(previousBP.Shutdown) == "function" then
    pcall(previousBP.Shutdown)
end

-- _G.BP only remembers the *last* load. A load that failed before assigning it,
-- or an older executor tab, leaves an instance that still owns worker loops and
-- keeps driving the character -- the new copy then fights it for the register,
-- the grill and the hands. Retire every live instance we can still reach.
-- Do NOT require prep.sweep here: that field only exists on recent builds, so
-- older instances survived the guard and kept looping at
-- "could not clear the hatch" while the new build took the orders. The
-- running/enabled/job signature is common to every build and is enough.
if type(getgc) == "function" then
    pcall(function()
        for _, t in getgc(true) do
            if type(t) == "table" and t.running == true
                and type(t.enabled) == "table" and type(t.job) == "table" then
                t.running = false
                for k in pairs(t.enabled) do t.enabled[k] = false end
            end
        end
    end)
end

-- ============================================================
-- EXECUTOR CHECK (soft — Potassium + Synapse/Krnl/Delta/Fluxus OK)
-- ============================================================
local function hasFn(name)
    return (_G and rawget(_G, name))
        or (debug and rawget(debug, name))
        or (getgenv and rawget(getgenv(), name))
end

local EXEC_FNS = {
    required = {},
    optional = {
        "getgenv", "getfenv", "getreg", "setreadonly",
        "getrawmetatable", "hookfunction", "newcclosure",
        "cloneref", "firetouchinterest", "firesignal",
    },
}

local missingRequired, missingOptional = {}, {}
for _, n in ipairs(EXEC_FNS.required) do
    if not hasFn(n) then table.insert(missingRequired, n) end
end
for _, n in ipairs(EXEC_FNS.optional) do
    if not hasFn(n) then table.insert(missingOptional, n) end
end

local execName, execVer = "unknown", "?"
pcall(function()
    if identifyexecutor then
        local a, b = identifyexecutor()
        execName, execVer = tostring(a), tostring(b)
    end
end)

if #missingRequired > 0 then
    GousseUI:Notify({
        Title = "Burger Planet",
        Content = "Missing required executor fn: "
            .. table.concat(missingRequired, ", "),
        Type = "error", Duration = 8,
    })
    return
end

if #missingOptional > 0 then
    print(("[Burger Planet] executor=%s %s - soft-missing: %s")
        :format(execName, execVer, table.concat(missingOptional, ", ")))
else
    print(("[Burger Planet] executor=%s %s - all optional fns present")
        :format(execName, execVer))
end

